{
  "name": "react-typescript",
  "version": "1.0.0",
  "description": "기타 코드·리듬·크로매틱 연습 웹 애플리케이션",
  "keywords": [
    "typescript",
    "react",
    "starter"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.0.0",
    "@mui/icons-material": "^6.4.1",
    "@mui/material": "^6.4.1",
    "@radix-ui/react-form": "^0.1.2",
    "@radix-ui/themes": "^3.0.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.0.0",
    "react-router-dom": "^6.28.0",
    "soundfont-player": "^0.12.0",
    "styled-components": "latest",
    "tone": "^15.0.4",
    "yup": "^0.32.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.2.5",
    "typescript": "^5.8.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "yarn typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint": "eslint src vite.config.ts --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "yarn@1.22.22",
  "type": "module"
